# Shopify CLI injects these after `shopify app dev` or `shopify app env show`.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products
SHOPIFY_APP_URL=https://localhost:3458
# SHOP_CUSTOM_DOMAIN=

# PostgreSQL. Use Railway's DATABASE_PUBLIC_URL locally and its private DATABASE_URL in Railway.
DATABASE_URL=postgresql://postgres:password@localhost:5432/marketing_copilot?schema=public

# Elasticsearch Cloud
ELASTIC_URL=https://YOUR_DEPLOYMENT.es.REGION.gcp.elastic.cloud:443
ELASTIC_API_KEY=

# Sentry server and browser monitoring
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=

SESSION_SECRET=
OPENAI_API_KEY=
NODE_ENV=development
PORT=3000
