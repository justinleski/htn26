// Prisma schema — Shopify Session/integrations plus merchant-scoped product data.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// Linked integrations per shop (e.g. Google Analytics OAuth tokens).
/// Merchants never paste GA API keys — tokens land here after OAuth.
model MerchantIntegration {
  id             String    @id @default(cuid())
  merchantId     String
  shop           String
  provider       String
  status         String    @default("disconnected")
  /// Opaque provider metadata (property id, account email, scopes, etc.)
  metadata       Json?
  /// Encrypted or server-only refresh token — never expose to the client
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  connectedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([merchantId, provider])
  @@index([shop])
}

model Merchant {
  id             String          @id @default(cuid())
  shopDomain     String          @unique
  settings       Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  products       Product[]
  reviews        Review[]
  adPerformance  AdPerformance[]
  insights       Insight[]
  campaigns      Campaign[]
  generationRuns GenerationRun[]
}

model Product {
  id              String          @id @default(cuid())
  merchantId      String
  shopifyId       String
  title           String
  description     String          @default("")
  price           Decimal         @db.Decimal(18, 4)
  currency        String          @db.Char(3)
  attributes      Json            @default("{}")
  sourceUpdatedAt DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  merchant        Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  reviews         Review[]
  adPerformance   AdPerformance[]
  insights        Insight[]
  campaigns       Campaign[]

  @@unique([merchantId, shopifyId])
  @@index([merchantId])
}

model Review {
  id          String   @id @default(cuid())
  merchantId  String
  sourceId    String
  productId   String
  rating      Int
  text        String
  source      String
  reviewedAt  DateTime
  attribution String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([merchantId, sourceId])
  @@index([merchantId, productId])
}

model AdPerformance {
  id                String   @id @default(cuid())
  merchantId        String
  sourceId          String
  productId         String
  campaignId        String
  messaging         String
  channel           String
  periodStart       DateTime
  periodEnd         DateTime
  impressions       Int
  clicks            Int
  purchases         Int
  spend             Decimal  @db.Decimal(18, 4)
  attributedRevenue Decimal  @db.Decimal(18, 4)
  currency          String   @db.Char(3)
  source            String
  attribution       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  merchant          Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([merchantId, sourceId])
  @@index([merchantId, productId])
  @@index([merchantId, campaignId])
}

model Insight {
  id                  String   @id @default(cuid())
  merchantId          String
  productId           String
  finding             String
  supportingSourceIds String[]
  observedMetrics     Json
  limitations         String[]
  createdAt           DateTime @default(now())
  merchant            Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([merchantId, productId])
}

model Campaign {
  id                  String          @id @default(cuid())
  merchantId          String
  productId           String
  objective           String
  audience            String
  strategy            String
  hooks               String[]
  captions            String[]
  variants            Json
  supportingSourceIds String[]
  validationResults   String[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  merchant            Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product             Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  generationRuns      GenerationRun[]

  @@index([merchantId, productId])
}

model GenerationRun {
  id           String    @id @default(cuid())
  merchantId   String
  status       String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  errorDetails String?
  campaignId   String?
  merchant     Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([merchantId, status])
}
