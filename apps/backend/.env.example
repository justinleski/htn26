# apps/backend — copy to .env and fill in. Never commit .env.
# After `shopify app dev`, the CLI may inject additional keys (e.g. SHOP_CUSTOM_DOMAIN).

# --- Shopify (Partner Dashboard / shopify app env) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_products,read_products
SHOPIFY_APP_URL=https://localhost:3458
# SHOP_CUSTOM_DOMAIN=

# --- Database (Railway Postgres or local) ---
# For local `shopify app dev`, use Railway's PUBLIC URL (TCP proxy), not the private *.railway.internal host.
# Railway → Postgres → Connect (or Variables) → copy DATABASE_PUBLIC_URL / public DATABASE_URL.
# Do NOT leave USER/PASSWORD/HOST placeholders — Prisma will fail with P1001.
DATABASE_URL=

# --- Session / app ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Elasticsearch (Elastic Cloud) ---
ELASTIC_URL=https://YOUR_DEPLOYMENT.es.REGION.gcp.elastic.cloud:443
ELASTIC_API_KEY=

# --- Sentry ---
SENTRY_DSN=
# The browser DSN is public by design and enables tracing + Session Replay.
VITE_SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=

# --- OpenAI (Dev 3; shared .env.example for the team) ---
OPENAI_API_KEY=

# --- Google Analytics OAuth (app-level client — NOT merchant API keys) ---
# Merchants use Connect with Google; they never paste these.
# Enable Analytics Data API + OAuth client in Google Cloud Console when wiring connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_APP_URL/auth/google/callback
# Optional default property for demos only:
# GA_DEFAULT_PROPERTY_ID=

# --- Node ---
NODE_ENV=development
PORT=3000
